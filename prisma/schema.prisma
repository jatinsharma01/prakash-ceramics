// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String      @id @default(cuid())
  sku           String      @unique
  name          String
  slug          String      @unique
  category      String
  categorySlug  String
  subcategory   String?
  range         String?
  tagline       String
  description   String      @db.Text
  price         Float
  originalPrice Float?
  stockCount    Int         @default(20)
  isFeatured    Boolean     @default(false)
  isNew         Boolean     @default(false)
  isBestseller  Boolean     @default(false)
  finishes      String[]    @default([])
  finishImages  Json?       // Map of finish name -> image URL
  images        String[]    @default([])
  dimensions    String?
  flowRate      String?
  material      String?     @default("Solid Forged Brass")
  warranty      String?     @default("15 Years Warranty")
  rating        Float       @default(4.9)
  reviewsCount  Int         @default(12)
  features      String[]    @default([])
  specs         Json?       // Key-value specifications
  salesDiscount Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]

  @@index([categorySlug])
  @@index([price])
}

model Category {
  id               String   @id @default(cuid())
  name             String   @unique
  slug             String   @unique
  shortDescription String
  description      String   @db.Text
  image            String
  featured         Boolean  @default(false)
  itemCount        Int      @default(0)
  tags             String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Sale {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  bannerText       String
  discountType     String    @default("percentage") // "percentage" | "fixed"
  discountValue    Float
  targetCategory   String?   // e.g. "faucets" or "all"
  targetProductIds String[]  @default([])
  badgeText        String?   @default("SPECIAL SALE")
  bannerImage      String?
  startDate        DateTime  @default(now())
  endDate          DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    @default("percentage") // "percentage" | "fixed"
  discountValue Float
  minOrderValue Float     @default(0)
  maxDiscount   Float?
  usageLimit    Int       @default(100)
  usedCount     Int       @default(0)
  startDate     DateTime  @default(now())
  expiryDate    DateTime
  status        String    @default("Active") // "Active" | "Expired" | "Scheduled"
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]

  @@index([code])
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerName      String
  customerEmail     String?
  customerPhone     String
  customerCity      String
  customerState     String
  customerAddress   String      @db.Text
  customerPincode   String?
  landmark          String?
  projectType       String?     @default("Residential Villa")
  notes             String?     @db.Text
  subtotal          Float
  tax               Float       @default(0)
  discount          Float       @default(0)
  total             Float
  paymentStatus     String      @default("Pending") // "Paid" | "Pending" | "Refunded" | "Failed"
  fulfillmentStatus String      @default("Processing") // "Delivered" | "Processing" | "Shipped" | "Cancelled"
  paymentMethod     String      @default("UPI / QR") // "UPI / QR" | "Credit Card" | "Net Banking" | "Bank Wire / RTGS"
  trackingNumber    String?
  couponId          String?
  coupon            Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode        String?
  userId            String?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([orderNumber])
  @@index([fulfillmentStatus])
  @@index([paymentStatus])
  @@index([customerEmail])
}

model CustomerUser {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  phone         String
  password      String
  avatar        String?
  city          String?           @default("Delhi NCR")
  tier          String            @default("Privilege Client") // "Privilege Client" | "VIP Architect" | "Luxury Homeowner"
  company       String?
  addresses     CustomerAddress[]
  cart          String?           @db.Text
  wishlist      String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([email])
}

model CustomerAddress {
  id            String        @id @default(cuid())
  userId        String
  user          CustomerUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  phone         String
  address       String        @db.Text
  city          String
  state         String
  pincode       String
  landmark      String?
  estateOrProject String?
  label         String        @default("Home") // "Home" | "Office" | "Site / Villa"
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  finish      String   @default("Chrome")
  quantity    Int      @default(1)
  price       Float
  image       String?
  createdAt   DateTime @default(now())
}

model AdminUser {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String
  avatar        String?
  city          String    @default("Delhi NCR")
  tier          String    @default("VIP Architect") // "VIP Architect" | "Luxury Homeowner" | "Commercial Contractor" | "Retail Buyer"
  totalOrders   Int       @default(0)
  totalSpent    Float     @default(0)
  status        String    @default("Active") // "Active" | "Inactive" | "VIP"
  joinedDate    DateTime  @default(now())
  lastOrderDate DateTime?
  company       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AdminAccount {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Parkash Administrator")
  role      String   @default("Super Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  projectType   String   @default("Residential Villa")
  preferredDate String?
  message       String   @db.Text
  source        String   @default("Contact Page") // "Home Page Consultation" | "Contact Page"
  status        String   @default("New") // "New" | "Contacted" | "Scheduled" | "Completed" | "Archived"
  adminNotes    String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model SyncSession {
  id        String   @id @default(cuid())
  code      String   @unique
  cart      String   @db.Text
  wishlist  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model PageSeo {
  id          String   @id @default(cuid())
  path        String   @unique // e.g. "/", "/products", "/about", "/contact", "/cart", "/wishlist"
  pageName    String   // Human-readable title e.g. "Home Page"
  title       String
  description String   @db.Text
  keywords    String?
  ogImage     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([path])
}



